{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-app.local/schemas/dsh-app.remote-plugins.schema.json",
  "title": "DSH App remote plugin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "policy", "targets"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Expected package.json name after installation."
          },
          "source": {
            "type": "string",
            "description": "Bare or exact npm package spec, or github:owner/repository pnpm spec."
          },
          "policy": {
            "enum": ["default", "required"]
          },
          "allowBuild": {
            "type": "boolean",
            "default": false,
            "description": "Allow this package to run pnpm install/build lifecycle scripts."
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["macos", "windows"] }
          },
          "editions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["bundled", "lite"] }
          }
        }
      }
    }
  }
}
