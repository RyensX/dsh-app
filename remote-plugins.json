      "source": "github:RyensX/dsh-message-fold",
      "policy": "default",
      "allowBuild": true,
      "targets": ["macos", "windows"],
      "editions": ["bundled", "lite"]
    },
    {
      "name": "dsh-message-navigation",
      "source": "github:RyensX/dsh-message-navigation",
      "policy": "default",
