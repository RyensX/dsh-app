{
  "build": {
    "beforeBuildCommand": "corepack pnpm@11.7.0 frontend:build:bundled",
    "frontendDist": "../dist/bundled"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DSH App",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "index.html",
        "width": 720,
        "height": 540,
        "minWidth": 420,
        "minHeight": 460,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["bundled"]
    }
  },
  "bundle": {
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": {
        "installerHooks": "bundled-installer-hooks.nsh"
      }
    }
  }
}
